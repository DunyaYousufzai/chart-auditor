# UBELIX settings for this project. Same as the ones that worked for spec-compression.
# To use the course allocation instead: ACCOUNT=teaching, GPU_PARTITION=teaching, GPU_QOS=job_teaching
ACCOUNT=gratis
GPU_PARTITION=gpu
GPU_QOS=job_gratis
GPU_GRES=gpu:rtx4090:1

PROJ_STORE=/storage/scratch/users/$USER/chart-auditor   # data, readings, model weights (30 TB quota)
VLLM_SIF=$PROJ_STORE/images/vllm.sif                    # vLLM 0.32, transformers 5.19, torch 2.13 cu130
CPU_VENV=$HOME/venvs/chart-auditor-cpu                  # matplotlib/pandas/scipy: data generation + evaluation
PY_MODULE=Python/3.11.3-GCCcore-12.3.0
